{
  "name": "dsh-mana-metacognition",
  "version": "0.1.0",
  "private": true,
  "description": "Mana 末那识·审：置信度 / 知识缺口 + 可移植 shoucang 判据阈值层（B5.1）",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./criteria": { "types": "./lib/types/criteria.d.ts", "default": "./lib/criteria.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "build": "tsc -p tsconfig.json",
    "gen:criteria": "node scripts/gen-criteria.mjs",
    "check:criteria": "node scripts/gen-criteria.mjs --check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "dsh-mana-core": "0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "dsh-mana-core": "file:../core"
  },
  "types": "./lib/types/index.d.ts",
  "files": ["lib", "src/criteria.generated.ts", "skill", "scripts", "cordis.patch.yml", "README.md"]
}
