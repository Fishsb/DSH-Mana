{
  "name": "dsh-mana-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Mana UI：Client 半区面板（激活值热力图 / 目标栈树 / 认知轨迹时间线）+ Host 侧读服务与 mana_trace 的 ui/render 落点",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "bundle:client": "node scripts/build-client.mjs",
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.1",
    "dsh-mana-core": "0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "dsh-mana-core": "file:../core"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ]
}
